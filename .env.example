# OpenObserve connection settings. Replace placeholders locally; never commit credentials.
OPENOBSERVE_URL=https://openobserve.example.com
OPENOBSERVE_ORG=your-org
OPENOBSERVE_EMAIL=service-account@example.com
OPENOBSERVE_TOKEN=replace-with-service-account-token

# Optional defaults
# OPENOBSERVE_STREAM=your-log-stream
# OPENOBSERVE_TRACE_STREAM=your-trace-stream
# OPENOBSERVE_INSECURE=0
